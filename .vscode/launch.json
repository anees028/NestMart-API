{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug nest-mart_api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:nest-mart:debug"],
      "console": "integratedTerminal",
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "envFile": "${workspaceFolder}/.env",
      "outputCapture": "std"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug email-service",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:email:debug"],
      "console": "integratedTerminal",
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "envFile": "${workspaceFolder}/.env",
      "outputCapture": "std"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to nest-mart_api",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to email-service",
      "port": 9230,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "Debug All Apps",
      "configurations": [
        "Debug nest-mart_api",
        "Debug email-service",
      ],
      "presentation": {
        "hidden": false,
        "group": "Debug",
        "order": 1
      },
      "stopAll": true
    }
  ]
}